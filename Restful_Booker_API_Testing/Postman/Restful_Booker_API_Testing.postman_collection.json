          "name": "CreateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response_body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response body contains 'bookingid' property\", function () {\r",
                  "    pm.expect(response_body).to.have.property(\"bookingid\")\r",
                  "})\r",
                  "if (response_body.hasOwnProperty(\"bookingid\")){\r",
                  "    pm.environment.set(\"bookingID\", response_body.bookingid);\r",
                  "}\r",
                  "\r",
                  "//These tests are created to compare and check values from request and response to see if they are the same.\r",
                  "pm.test(\"Firstname value check\", function () {\r",
                  "    pm.expect(response_body.booking.firstname).to.eql(pm.environment.get(\"firstname\"));\r",
                  "});\r",
                  "pm.test(\"Lastname value check\", function () {\r",
                  "    pm.expect(response_body.booking.lastname).to.eql(pm.environment.get(\"lastname\"));\r",
                  "});\r",
                  "pm.test(\"Totalprice value check\", function () {\r",
                  "    pm.expect(response_body.booking.totalprice).to.eql(Number(pm.environment.get(\"totalprice\")));\r",
                  "});\r",
                  "pm.test(\"Depositpaid value check\", function () {\r",
                  "    pm.expect(response_body.booking.depositpaid).to.eql(pm.environment.get(\"depositpaid\") === 'true');\r",
                  "});\r",
                  "pm.test(\"Checkin value check\", function () {\r",
                  "    pm.expect(response_body.booking.bookingdates.checkin).to.eql(pm.environment.get(\"checkin\"));\r",
                  "});\r",
                  "pm.test(\"Checkout value check\", function () {\r",
                  "    pm.expect(response_body.booking.bookingdates.checkout).to.eql(pm.environment.get(\"checkout\"));\r",
                  "});\r",
                  "pm.test(\"Additionalneeds value check\", function () {\r",
                  "    pm.expect(response_body.booking.additionalneeds).to.eql(pm.environment.get(\"additionalneeds\"));\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
